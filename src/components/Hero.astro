---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { site } from '../lib/content';
import Emblem from './Emblem.astro';
import Thorns from './Thorns.astro';

// Drop your painting at src/assets/painting.(jpg|png|webp|avif), 2560px wide or more.
// Without it the hero uses the built-in dark gradient.
const found = import.meta.glob<{ default: ImageMetadata }>('/src/assets/painting.{jpg,jpeg,png,webp,avif}', { eager: true });
const painting = Object.values(found)[0]?.default;
const { brand, links, socials, packs } = site;

const listen = [
  { name: 'spotify', label: 'Listen on Spotify', url: links.spotify },
  { name: 'apple', label: 'Listen on Apple Music', url: links.appleMusic },
] as const;
const shop = packs ? '#packs' : links.soundPacks;
const external = packs ? {} : { target: '_blank', rel: 'noopener noreferrer' };
---

<header class="hero" id="top" data-hero>
  <div class="hero__art" aria-hidden="true">
    {
      painting && (
        <Picture
          src={painting}
          alt=""
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[800, 1280, 1920, 2560]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
  </div>
  {site.fx.embers && <canvas class="embers" data-embers aria-hidden="true"></canvas>}
  <div class="hero__body">
    <img class="hero__emblem" src={brand.emblem} alt={`${brand.name} emblem`} width="190" height="190" />
    <!-- split into letters at build time: the load animation is pure CSS, so there is nothing to wait for and nothing to flash -->
    <h1 class="hero__title" data-glitch aria-label={brand.name}>
      {[...brand.name].map((ch, i) => <span class="ch" style={`--i:${i}`} aria-hidden="true">{ch}</span>)}
    </h1>
    <p class="hero__tag">{brand.tagline}</p>
    <div class="emblems">
      <p class="label">listen</p>
      <div class="row row--listen" data-beam>
        <span class="beam" aria-hidden="true"></span>
        <ul>{listen.map((l, i) => <Emblem {...l} i={i} />)}</ul>
      </div>
      <p class="label">follow</p>
      <div class="row row--follow" data-beam>
        <span class="beam" aria-hidden="true"></span>
        <ul>{socials.map((s, i) => <Emblem name={s.mark} label={`Follow on ${s.label}`} url={s.url} i={i + 2} />)}</ul>
      </div>
    </div>
    <nav class="hero__links" aria-label="main">
      <a class="btn" href="#work" data-decode data-magnet>Work with me</a>
      <a class="btn" href={shop} {...external} data-decode data-magnet>Shop</a>
    </nav>
  </div>
  <Thorns />
</header>
