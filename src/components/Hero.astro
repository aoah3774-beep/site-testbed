---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { site } from '../lib/content';
import FollowMenu from './FollowMenu.astro';
import ListenMenu from './ListenMenu.astro';

// Drop your painting at src/assets/painting.(jpg|png|webp|avif), 2560px wide or more.
// Without it the hero uses the built-in dark gradient.
const found = import.meta.glob<{ default: ImageMetadata }>('/src/assets/painting.{jpg,jpeg,png,webp,avif}', { eager: true });
const painting = Object.values(found)[0]?.default;
const { brand } = site;
---

<header class="hero" id="top" data-hero>
  <div class="hero__art" aria-hidden="true">
    {
      painting && (
        <Picture
          src={painting}
          alt=""
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[800, 1280, 1920, 2560]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
  </div>
  {site.fx.embers && <canvas class="embers" data-embers aria-hidden="true"></canvas>}
  <div class="hero__body">
    <img class="hero__emblem" src={brand.emblem} alt={`${brand.name} emblem`} width="190" height="190" />
    <h1 class="hero__title" data-glitch>{brand.name}</h1>
    <p class="hero__tag">{brand.tagline}</p>
    <nav class="hero__links" aria-label="main">
      <ListenMenu />
      <a class="btn" href="#table" data-decode>On the table</a>
      <a class="btn" href="#work" data-decode>Work with me</a>
      <FollowMenu />
    </nav>
    {site.packs?.teaser && <a class="hero__packs label" href="#packs">{site.packs.teaser}</a>}
  </div>
</header>
