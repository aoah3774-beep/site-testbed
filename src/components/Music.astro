---
import { site } from '../lib/content';
import Mark from './Mark.astro';

const social = (label: string) => site.socials.find((s) => s.label.toLowerCase() === label)?.url ?? '';
// the schema guarantees YouTube and Twitch exist in socials
const faces = [
  { name: 'spotify', label: 'Spotify', url: site.links.spotify },
  { name: 'apple', label: 'Apple Music', url: site.links.appleMusic },
  { name: 'youtube', label: 'YouTube', url: social('youtube') },
  { name: 'twitch', label: 'Twitch', url: social('twitch') },
] as const;
---

<section class="section" id="music" aria-labelledby="music-h">
  <h2 id="music-h" data-glitch>music</h2>
  <p class="label">listen anywhere.</p>
  <!-- plain 2x2 link grid without JS or with reduced motion; src/fx/orb.ts turns it into a gyroscope -->
  <div class="orb" data-orb>
    <div class="orb__g1">
      <div class="orb__g2">
        <div class="orb__core">
          {
            faces.map((f, i) => (
              <a class="orb__face" href={f.url} target="_blank" rel="noopener noreferrer" style={`--i:${i}`} aria-label={f.label}>
                <Mark name={f.name} />
                <span>{f.label}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
