---
import { site } from '../lib/content';
const { packs, links } = site;
---

{
  packs && (
    <section class="section" id="packs" aria-labelledby="packs-h">
      <h2 id="packs-h" data-glitch>{packs.title}</h2>
      <p class="label">{packs.blurb}</p>
      {
        packs.items.length > 0 && (
          <ul class="packs">
            {packs.items.map((p) => (
              <li>
                <a class="pack" href={p.url} target="_blank" rel="noopener noreferrer">
                  <span class="raw"><img src={p.cover} alt="" width="400" height="400" loading="lazy" decoding="async" /></span>
                  <span class="pack__title">{p.title}</span>
                  <span class="label">{[p.tag, p.price].filter(Boolean).join(' / ')}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <a class="btn" href={links.soundPacks} target="_blank" rel="noopener noreferrer" data-decode>Browse sound packs</a>
    </section>
  )
}
